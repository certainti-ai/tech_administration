# One deployment environment's connection settings, for scripts/secrets/set-environment.sh.
#
#   cp environment.env.example qa.env      # then fill it in
#   ./set-environment.sh qa qa.env         # dry run — prints names and digests
#   ./set-environment.sh qa qa.env --apply
#
# Then DELETE the file. It holds passwords in plain text, and every name here is
# also in .gitignore for the same reason.
#
# Use the plain names below whichever environment this is; the script adds the
# environment prefix when it writes to the vault, so MAINDB_PASSWORD in qa.env
# becomes the secret `trd365-qa-maindb-password`. That prefix is what stops a
# QA credential from ever being served to a prod utility.
#
# Every field is required. There is no partial state: a missing host or dbname
# would otherwise fall back to a placeholder, and the point of the placeholder is
# to fail loudly rather than connect somewhere unintended.

# --- Main application database (through an SSH bastion) ---------------------
MAINDB_HOST=
MAINDB_PORT=5432
MAINDB_DBNAME=
MAINDB_USER=
MAINDB_PASSWORD=
# require, prefer, disable. `require` unless the server cannot do TLS.
MAINDB_SSLMODE=require
MAINDB_SSH_HOST=
MAINDB_SSH_PORT=22
MAINDB_SSH_USER=
MAINDB_SSH_PASSWORD=

# --- Organisation database (through an SSH bastion) -------------------------
ORGDB_HOST=
ORGDB_PORT=5432
ORGDB_DBNAME=
ORGDB_USER=
ORGDB_PASSWORD=
ORGDB_SSLMODE=require
ORGDB_SSH_HOST=
ORGDB_SSH_PORT=22
ORGDB_SSH_USER=
ORGDB_SSH_PASSWORD=

# --- TRD365 AI database (direct, no bastion) -------------------------------
TRD365AI_HOST=
TRD365AI_PORT=5432
TRD365AI_DBNAME=
TRD365AI_USER=
TRD365AI_PASSWORD=
TRD365AI_SSLMODE=require
