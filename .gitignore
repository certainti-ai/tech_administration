# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — anything fetched from Key Vault lands in one of these
.env*.local
*.secrets.env
secrets.env
# Filled-in copies of scripts/secrets/environment.env.example. The example
# itself is empty and tracked; anything named for an environment holds real
# passwords and is not.
dev.env
qa.env
stage.env
prod.env

# vercel
.vercel

# typescript
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# The exception to "tfvars hold secrets": this one holds the live deployment's
# non-secret settings so a rebuild comes up as itself. Its own header says what
# may not go in it.
!infra/terraform/deployment.auto.tfvars
crash.log
*.tfplan
tfplan
config.bat
