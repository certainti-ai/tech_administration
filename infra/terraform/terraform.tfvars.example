# Copy to terraform.tfvars and fill in — or better, supply these as TF_VAR_*
# environment variables (see PREFLIGHT.md), which is how this project already
# supplies its database credentials and needs no file at all.
#
# terraform.tfvars is gitignored. Do not commit a filled-in copy.

# --- ALREADY SUPPLIED BY THE ENVIRONMENT — do not set these -----------------
#
# subscription_id  read from ARM_SUBSCRIPTION_ID by the azurerm provider
# (auth)           ARM_TENANT_ID / ARM_CLIENT_ID / ARM_CLIENT_SECRET likewise
#
# location         defaults to "centralus", read off the database hostnames
#                  (prod-thinkrd365-psqlserver-centralus-pvt-main). Override
#                  only if the VM belongs in a different region on purpose.

# --- STILL NEEDED -----------------------------------------------------------

# Existing resource group to create into.
resource_group_name = "certainti-platform"

# THE critical input, and the one most likely to be wrong. This subnet must
# reach the SSH bastion (172.203.151.166) — and so maindb and orgdb behind it —
# plus trd365ai (4.246.251.140) directly, for every environment the application
# monitors. A VM in the wrong subnet comes up unable to see anything.
subnet_id = "/subscriptions/.../resourceGroups/.../providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>"

# The Key Vault holding the database credentials. NOTE: this vault may not exist
# yet — nothing has ever been pushed to one (see docs/secrets.md). Create it
# first, or decide that Terraform should create it, before applying.
key_vault_id   = "/subscriptions/.../resourceGroups/.../providers/Microsoft.KeyVault/vaults/<vault>"
key_vault_name = "<vault>"

# Public key only. Password authentication is disabled unconditionally.
admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# --- optional, shown with their defaults ------------------------------------

# name_prefix     = "trd365-maint"
# vm_size         = "Standard_D2s_v5"
# admin_username  = "trd365admin"
# os_disk_size_gb = 64
# app_port        = 8080
# app_branch      = "main"

# Leave false. A maintenance host that can purge production should not be
# reachable from the internet; use Azure Bastion or `az vm run-command`.
# assign_public_ip = false

# Only consulted when assign_public_ip is true. 0.0.0.0/0 is rejected.
# allowed_ssh_source_prefixes = ["10.0.0.0/8"]

# Who may reach the application port. Keep this to the VNet or a proxy subnet.
# allowed_app_source_prefixes = ["10.0.0.0/8"]
