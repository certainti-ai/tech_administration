# Copy to terraform.tfvars and fill in — or supply these as TF_VAR_* environment
# variables, which is how this project already supplies its database credentials
# and needs no file at all. terraform.tfvars is gitignored.

# --- SUPPLIED BY THE ENVIRONMENT — do not set ------------------------------
#
# subscription_id  read from ARM_SUBSCRIPTION_ID by the azurerm provider
# (auth)           ARM_TENANT_ID / ARM_CLIENT_ID / ARM_CLIENT_SECRET likewise

# --- NOTHING IS REQUIRED ----------------------------------------------------
#
# `terraform apply` with no variables at all stands up a complete, self-contained
# deployment: its own resource group, virtual network, subnet, Key Vault, SSH key
# pair, managed identity and VM. It changes nothing that already exists and it
# peers with nothing.
#
# That works because the databases are reached over public endpoints — an SSH
# tunnel to the bastion (172.203.151.166) for maindb and orgdb, and a public
# address for trd365ai (4.246.251.140) — which is the same path the operator
# scripts already take from a laptop. Outbound internet is the only network
# dependency.

# --- CREATED FOR YOU — override only if you want something else -------------
#
# resource_group_name   = "trd365-maintenance"   created; set create_resource_group=false to reuse one
# key_vault_name        = null                   generated with a random suffix (vault names are globally unique)
# admin_ssh_public_key  = null                   a key pair is generated and the private half stored in the vault
# location              = "centralus"            read off the database hostnames; nothing peers, so this is a
#                                                latency and cost choice, not a topology constraint
# vnet_address_space    = ["10.80.0.0/16"]       unroutable to anything else by design
# subnet_address_prefix = "10.80.1.0/24"

# --- optional ---------------------------------------------------------------

# Join an existing subnet instead of creating a network. Only do this if you
# have decided the host belongs inside an existing VNet, and accept the coupling.
# subnet_id = "/subscriptions/.../virtualNetworks/<vnet>/subnets/<subnet>"

# Bring your own key instead of generating one. Preferred for anything
# long-lived: a generated key's private half lands in Terraform state.
# admin_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# Reuse existing infrastructure rather than creating it.
# create_resource_group = false
# create_key_vault      = false
# existing_key_vault_id = "/subscriptions/.../vaults/<vault>"

# Turn ON once the vault holds real secrets. Cannot be turned off again, and
# blocks destroy/recreate for the retention window. See SECURITY.md.
# key_vault_purge_protection = true

# Once the VM is the vault's only consumer, close it off and use a private endpoint.
# key_vault_public_network_access = false

# name_prefix     = "trd365-maint"
# vm_size         = "Standard_D2s_v5"
# admin_username  = "trd365admin"
# os_disk_size_gb = 64
# app_port        = 8080
# app_branch      = "main"

# Leave false. A maintenance host that can purge production should not be
# reachable from the internet; use Azure Bastion or `az vm run-command`.
# assign_public_ip = false
# allowed_ssh_source_prefixes = ["10.0.0.0/8"]   # only read when assign_public_ip is true
# allowed_app_source_prefixes = ["10.0.0.0/8"]   # who may reach the app port
