#cloud-config
# Bootstrap for the trd365 maintenance VM.
#
# Installs the runtime, creates a dedicated service account, lays out the
# directories the application writes to, clones the repository, and runs the
# first deploy.
#
# The clone happens here rather than in deploy.sh because deploy.sh *lives in the
# repository*. Leaving it to the deploy script is circular — the script cannot
# fetch the tree that contains it — and the result is a VM whose deploy unit
# points at a file that will never exist. So cloud-init makes the first clone,
# and deploy.sh maintains it from then on.

package_update: true
package_upgrade: true

packages:
  - python3.12
  - python3.12-venv
  - python3-pip
  - git
  - postgresql-client
  - openssh-client
  - curl
  - jq
  - unzip

users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
  # Unprivileged account the application runs as. No login shell: it is a
  # service identity, not a person, and nothing should be run as it by hand
  # except through the deploy script.
  - name: trd365
    system: true
    shell: /usr/sbin/nologin
    homedir: /opt/trd365
    # systemd-journal so deploy.sh can read the service's own log when a restart
    # fails, without being root.
    groups: [systemd-journal]

write_files:
  # Environment shared by the service and by interactive utility runs. It holds
  # no secrets — only the vault name and the identity that can read it.
  - path: /etc/trd365/environment
    permissions: "0644"
    content: |
      AZURE_KEY_VAULT_NAME=${key_vault_name}
      AZURE_CLIENT_ID=${client_id}
      TRD365_MODEL_DIR=/var/lib/trd365/model
      TRD365_AUDIT_DIR=/var/lib/trd365/audit
      TRD365_APP_PORT=${app_port}
      TRD365_REPO_URL=${repository_url}
      TRD365_BRANCH=${branch}
      # Turns on the header authenticator the service ships for development.
      # Only ever set when Caddy is in front: Caddy does the authenticating and
      # then injects the identity, and 8080 is never opened to the network.
      TRD365_DEV_AUTH=${expose_publicly ? "1" : "0"}

  # Caddy: TLS, a login, and a deliberately powerless identity upstream.
  #
  # The identity handed upstream is whatever `demo_roles` says — `viewer` by
  # default, which can read everything and start nothing.
  #
  # With `operator`, the login can start utilities, and what makes that tolerable
  # is not the login: it is that an operator cannot finish anything consequential
  # alone. A production run that writes waits for a second person and cannot be
  # self-approved; a production preview of the project purges waits too, because
  # their preview executes the work and rolls it back rather than counting rows.
  # See the `demo_roles` variable for the full reasoning.
  #
  # This host holds credentials that can delete production data, and no login
  # page is strong enough to be the only thing standing in the way — so the
  # second-approver rule is the thing being relied on, and it is tested.
  # Staged here, NOT at /etc/caddy/Caddyfile. That path is a dpkg conffile owned
  # by the caddy package: pre-creating it makes `apt-get install caddy` stop at a
  # "keep your currently-installed version?" prompt, and with no stdin dpkg
  # aborts, leaving the binary unpacked and the package unconfigured. The setup
  # script installs the package first and then puts this in place.
  - path: /etc/trd365/Caddyfile
    permissions: "0644"
    content: |
      {
        admin off
      }

      ${caddy_site} {
        encode zstd gzip

        basic_auth {
          {$TRD365_DEMO_USER} {$TRD365_DEMO_HASH}
        }

        reverse_proxy 127.0.0.1:${app_port} {
          header_up X-Dev-User {http.auth.user.id}
          header_up X-Dev-Roles ${demo_roles}
        }

        header {
          Strict-Transport-Security "max-age=31536000"
          X-Content-Type-Options nosniff
          X-Frame-Options DENY
          Referrer-Policy no-referrer
          -Server
        }

        # To the journal, not a file. The packaged unit sandboxes the
        # filesystem, so a file under /var/log is "permission denied" no matter
        # who owns it — and journald already handles rotation and retention,
        # which a file here would need configuring separately.
        #   journalctl -u caddy -f
        log {
          output stderr
        }
      }

  # Read by the Caddy unit. Holds a bcrypt hash, never the password itself, and
  # is generated on the host rather than committed anywhere.
  - path: /etc/systemd/system/caddy.service.d/override.conf
    permissions: "0644"
    content: |
      [Service]
      EnvironmentFile=/etc/caddy/demo.env

  # The service account is unprivileged, but the deploy has to restart the
  # application unit. Exactly those two verbs on exactly that unit — not
  # NOPASSWD:ALL, on a host that can purge production.
  - path: /etc/sudoers.d/trd365-deploy
    permissions: "0440"
    content: |
      trd365 ALL=(root) NOPASSWD: /usr/bin/systemctl restart trd365-admin.service
      trd365 ALL=(root) NOPASSWD: /usr/bin/systemctl start trd365-admin.service

  # Self-updating deploys. The timer runs deploy.sh, which fetches the deployed
  # branch, installs it, and restarts the service only if the test suite passes —
  # otherwise it rolls the checkout back and leaves the running service alone.
  # Set auto_deploy_schedule to "" in Terraform to disable and deploy by hand.
  - path: /etc/systemd/system/trd365-deploy.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Fetch, test and deploy the latest Certainti Tech Administration commit
      Documentation=https://github.com/certainti-ai/tech_administration
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      User=trd365
      Group=trd365
      EnvironmentFile=/etc/trd365/environment
      # The repository's own copy, so a change to the deploy script ships with
      # the change that needs it. /opt/trd365/deploy.sh is a symlink to this.
      ExecStart=/opt/trd365/app/infra/deploy/deploy.sh
      # A deploy that hangs must not block every later one.
      TimeoutStartSec=1800
      StandardOutput=journal
      StandardError=journal
      SyslogIdentifier=trd365-deploy

  - path: /etc/systemd/system/trd365-deploy.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Deploy the latest commit on a schedule

      [Timer]
      OnCalendar=${auto_deploy_schedule}
      # Catch up after the VM has been off, rather than waiting for the next slot.
      Persistent=true
      # Keeps a fleet from all pulling at the same instant, and makes it obvious
      # in the log that the run time is not meant to be exact.
      RandomizedDelaySec=300
      Unit=trd365-deploy.service

      [Install]
      WantedBy=timers.target

  - path: /etc/systemd/system/trd365-admin.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Certainti Tech Administration
      Documentation=https://github.com/certainti-ai/tech_administration
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=exec
      User=trd365
      Group=trd365
      EnvironmentFile=/etc/trd365/environment
      WorkingDirectory=/opt/trd365/app
      # Loopback only. Caddy is the sole consumer and reaches it over loopback,
      # so binding every interface buys nothing and costs a second line of
      # defence: if the network rules are ever loosened by accident, the
      # application still is not listening on a routable address.
      ExecStart=/opt/trd365/venv/bin/uvicorn trd365_orchestrator.app:app \
          --host 127.0.0.1 --port ${app_port} --proxy-headers

      Restart=on-failure
      RestartSec=5s
      # Survives reboot and keeps restarting through a bad patch, rather than
      # giving up after a burst of failures (PRD FR-5.2).
      StartLimitIntervalSec=0

      # A host that can purge production gets no more of the filesystem than it
      # needs. State lives in two directories; everything else is read-only.
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectSystem=strict
      ProtectHome=true
      ReadWritePaths=/var/lib/trd365 /var/log/trd365
      ProtectKernelTunables=true
      ProtectControlGroups=true
      RestrictSUIDSGID=true

      StandardOutput=journal
      StandardError=journal
      SyslogIdentifier=trd365-admin

      [Install]
      WantedBy=multi-user.target

runcmd:
  - mkdir -p /opt/trd365 /var/lib/trd365/model /var/lib/trd365/audit /var/log/trd365
  - chown -R trd365:trd365 /opt/trd365 /var/lib/trd365 /var/log/trd365
  - chmod 0750 /var/lib/trd365/audit
  - python3.12 -m venv /opt/trd365/venv
  - /opt/trd365/venv/bin/pip install --upgrade pip
  - chown -R trd365:trd365 /opt/trd365/venv
  - git config --system --add safe.directory /opt/trd365/app
  # The first clone. deploy.sh takes over from here, and hard-resets to the
  # deployed branch on every run, so this only has to be good enough to start.
  - sudo -u trd365 git clone --branch ${branch} ${repository_url} /opt/trd365/app
  - ln -sfn /opt/trd365/app/infra/deploy/deploy.sh /opt/trd365/deploy.sh
  - ln -sfn /opt/trd365/app/infra/deploy/verify.sh /opt/trd365/verify.sh
  - systemctl daemon-reload
  - systemctl enable trd365-admin.service
  # Enabled only when a schedule was configured; deploy.sh still runs by hand.
  - test -z "${auto_deploy_schedule}" || systemctl enable --now trd365-deploy.timer
  # Caddy, only when this deployment is meant to be reachable. The script is
  # versioned in the repository — hence after the clone — so it is reviewable and
  # shellcheck runs over it in CI, rather than being a blob inside this YAML.
  - test "${expose_publicly}" != "true" || /opt/trd365/app/infra/deploy/setup-caddy.sh '${demo_username}' '${demo_password}'

  # Deploy now rather than at the next slot. Without this a VM built at 06:05
  # sits with no application until 09:00, and the operator has no way to tell
  # a slow bootstrap from a broken one. --no-block so cloud-init finishes while
  # the install and the test suite run.
  - systemctl start --no-block trd365-deploy.service

final_message: "trd365 maintenance VM ready after $UPTIME seconds. The first deploy is running: journalctl -u trd365-deploy -f"
